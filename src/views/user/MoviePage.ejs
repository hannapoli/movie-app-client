<%- include('../templates/header') %>
<%- include('./templates/nav') %>

<main class="container mb100">
    <% if (!pelicula) { %>
        <p class="info"><%= msg || 'No se encontró la película' %></p>
    <% } else { %>
        <section class="detalle-container">
            <div class="detalle-card">
                <% if (pelicula.filename) { %>
                    <img 
                        class="detalle-img"
                        src="<%= backendUrl %>uploads/<%= pelicula.filename %>" 
                        alt="<%= pelicula.tit_pelicula %>"
                        loading="lazy"
                    >
                <% } else { %>
                    <div class="peli-poster no-poster" style="width:100%; border-radius:8px;">
                        <%= pelicula.tit_pelicula %>
                    </div>
                <% } %>

                <div class="detalle-info">
                    <h1 class="detalle-titulo"><%= pelicula.tit_pelicula %></h1>
                    <p class="detalle-descripcion"><span class="negrita">Año:</span> <%= pelicula.ano_pelicula %></p>
                    <p class="detalle-descripcion"><span class="negrita">Director:</span> <%= pelicula.director %></p>
                    <p class="detalle-descripcion"><span class="negrita">Duración:</span> <%= pelicula.duracion %> min</p>
                    <p class="detalle-descripcion"><span class="negrita">Género:</span> <%= pelicula.genero %></p>

                    <form action="/user/userFavoritos/agregar" method="POST" style="margin-top:8px;">
                        <input type="hidden" name="idPelicula" value="<%= pelicula.id_pelicula %>">
                        <button class="btn-primary" type="submit">❤ Añadir a favoritos</button>
                    </form>
                </div>
            </div>
        </section>
    <% } %>

</main>

<%- include('../templates/footer') %>
