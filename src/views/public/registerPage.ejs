<%- include("../templates/header.ejs") %>
<div class="auth-container">
        <h1 class="title">Crear cuenta</h1>
        <form action="/resgistro-back" method="POST" class="auth-form">
            <input type="text" name="username" placeholder="Nombre" required novalidate>
            <input type="email" name="email" placeholder="Correo electrónico" required novalidate>
            <input type="password" name="password" placeholder="Contraseña" required novalidate>
            <button type="submit" class="btn-primary">Registrarse</button>
        </form>
        <p class="switch-text">
            ¿Ya tienes cuenta?
            <a href="/" class="switch-link">Inicia sesión</a>
        </p>
    </div>
<%- include("../templates/footer.ejs") %>