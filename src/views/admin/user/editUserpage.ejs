<%- include("../../templates/header.ejs") %>

    <main class="auth-container">
        <h2 class="title">Crear Usuario</h2>
        <form action="/admin/user/userUpgrade/<%= usuario.id_usuario %>" method="PUT"  name="formRegistro"  novalidate class="auth-form">
            <input type="text" id="nombre_usuario" name="nombre_usuario" placeholder="Nombre" value="<%= usuario.nombre_usuario %>">
            <input type="email" id="email" name="email" placeholder="Email" value="<%= usuario.email %>">
            <select name="role_usuario" id="role_usuario">
                <option value="admin" <%= usuario.role_usuario === 'admin' ? 'selected' : '' %>>Admin</option>
                <option value="user" <%= usuario.role_usuario === 'user' ? 'selected' : '' %>>User</option>
            </select>
            <input type="text" id="contrasena" name="contrasena" placeholder="password">
            <button class="btn-primary" type="submit">Actualizar</button>
        </form>
    </main>
<%- include("../../templates/footer") %>