<%- include("../templates/header.ejs") %>

    <main class="auth-container">
        <h2 class="title">Crear Usuario</h2>

        <form action="/user/upgrade" method="PUT"  name="formRegistro"  novalidate class="auth-form">
            <input type="text" id="nombre_usuario" name="nombre_usuario" placeholder="Nombre" value="<%= nombre_usuario %>">
            <input type="email" id="email" name="email" placeholder="Email" value="<%= email %>">
            <select name="role_usuario" id="role_usuario">
                <option selected value="<%= role_usuario %>"></option>
                <option value="administrador">administrador</option>
                <option value="user">user</option>
            </select>
            <input type="text" id="contrasena" name="contrasena" placeholder="password">
            <button class="btn-primary" type="submit">enviar</button>
        </form>
    </main>
<%- include("../../templates/footer") %>

