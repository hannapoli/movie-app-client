<%- include("../../templates/header.ejs") %>
<%- include("../template/navAdmin.ejs") %>

    <main class="auth-container">
        <h2 class="title">Editar Usuario</h2>
            <% if (typeof success !== 'undefined') { %>
                <div style="color: green; margin-bottom: 1em;">
                    <%= success %>
                </div>
                <% } %>
                <% if (typeof error !== 'undefined') { %>
                <div style="color: red; margin-bottom: 1em;">
                    <%= error %>
                </div>
            <% } %>
        <form action="/admin/user/userUpgrade/<%= usuario.id_usuario %>" method="POST"  name="formRegistro"  novalidate class="auth-form">
            <input type="hidden" name="_method" value="PUT">
            <input type="text" id="nombre_usuario" name="nombre_usuario" placeholder="Nombre" value="<%= usuario.nombre_usuario %>">
            <input type="email" id="email" name="email" placeholder="Email" value="<%= usuario.email %>">
            <select name="role_usuario" id="role_usuario">
                <option value="administrador" <%= usuario.role_usuario === 'administrador' ? 'selected' : '' %>>Admin</option>
                <option value="user" <%= usuario.role_usuario === 'user' ? 'selected' : '' %>>User</option>
            </select>
            <input type="text" id="contrasena" name="contrasena" placeholder="password">
            <button class="btn-primary" type="submit">Actualizar</button>
        </form>
        <a href="/admin/user/userall" class="btn-retroceder">Retroceder</a>
        
    </main>
<%- include("../../templates/footer") %>