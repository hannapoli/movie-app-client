<%- include("../../templates/header") %>

    <main class="container">
        <h1>Añadir una película</h1>

        <form action="/admin/movies/create" method="POST" enctype="multipart/form-data" class="flexColumn auth-form">
            <input type="number" id="id_pelicula" name="id_pelicula" novalidate hidden>
            <div class="flexColumn">
                <label for="tit_pelicula">Título</label>
                <input type="text" id="tit_pelicula" name="tit_pelicula" novalidate>
            </div>
            <div class="flexColumn">
                <label for="director">Director</label>
                <input type="text" id="director" name="director">
            </div>
            <div class="flexColumn">
                <label for="ano_pelicula">Año</label>
                <input type="number" id="ano_pelicula" name="ano_pelicula" novalidate>
            </div>
            <div class="flexColumn">
                <label for="genero">Genero</label>
                <input type="text" id="genero" name="genero" novalidate>
            </div>
            <div class="flexColumn">
                <label for="duracion">Duración</label>
                <input type="text" id="duracion" name="duracion" novalidate>
            </div>
            <div class="flexColumn">
                <label for="imagen">Portada</label>
                <input type="file" id="imagen" name="imagen" accept="image/*">
            </div>
            <div class="flexColumn">
                <label for="descripcion">Descripción</label>
                <input type="text" id="descripcion" name="descripcion" novalidate>
            </div>
            <div class="flexColumn container-btn">
                <button type="submit" class="btn-primary">Crear película</button>
            </div>
        </form>
    </main>
    <%- include("../../templates/footer") %>