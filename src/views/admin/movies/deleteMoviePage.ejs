<%- include("../../templates/header") %>

    <main class="container">
        <h1>Eliminar la película</h1>

        <form action="/admin/movies/delete/<%= pelicula.id_pelicula %>" method="POST" enctype="multipart/form-data"
            class="flexColumn">
            <label>Seguro que quiere eliminar esta película?</label>
            <input type="number" id="id_pelicula" name="id_pelicula" value="<%= pelicula.id_pelicula%>" hidden novalidate>
            <div class="flexColumn">
                <label for="tit_pelicula">Título</label>
                <input type="text" id="tit_pelicula" name="tit_pelicula" value="<%= pelicula.tit_pelicula%>" novalidate>
            </div>
            <button type="submit">Eliminar</button>
            <%- include("../../templates/footer") %>