<%- include("../../templates/header") %>

    <main class="container">
        <h1>Películas</h1>
        <a href="/admin/movies/create"><button>Añadir película</button></a>
        <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Director</th>
                    <th>Año</th>
                    <th>Género</th>
                    <th>Duración</th>
                    <th>Imagen</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% peliculas.forEach((peli)=> { %>
                    <tr>
                        <td>
                            <%= peli.tit_pelicula %>
                        </td>
                        <td>
                            <%= peli.director %>
                        </td>
                        <td>
                            <%= peli.ano_pelicula %>
                        </td>
                        <td>
                            <%= peli.genero %>
                        </td>
                        <td>
                            <%= peli.duracion %>
                        </td>
                        <td>
                            <% if (peli.filename) { %>
                                <img src="<%= backendUrl %>uploads/<%= peli.filename %>" alt="<%= peli.tit_pelicula %>"
                                    style="max-width: 4em;">
                                <% } else { %>
                                    <span>
                                        <%= peli.tit_pelicula %>
                                    </span>
                                    <% } %>
                        </td>
                        <td>
                            <a href="/admin/movies/edit/<%= peli.id_pelicula %>"><button>✏️</button></a>
                            <a href="/admin/movies/delete/<%= peli.id_pelicula %>"><button>🗑️</button></a>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>

    </main>
    <%- include("../../templates/footer") %>