<%- include("../../templates/header") %>

    <main class="container">
        <h1>Películas</h1>
        <div class="flexColumn container-btn">
            <a href="/admin/movies/create"><button class="btn-primary">Añadir película</button></a>
        </div>

        <div class="pelis-grid">
            <% peliculas.forEach((peli)=> { %>
                <div class="peli-card">
                    <div class="peli-poster"
                        style="background-image: url('<%= backendUrl %>uploads/<%= peli.filename%>')">
                        <% if (!peli.filename) { %>
                            <div class="no-poster">
                                <%= peli.tit_pelicula %>
                            </div>
                            <% } %>
                                <div class="peli-btns">
                                    <a href="/admin/movies/edit/<%= peli.id_pelicula %>" class="peli-btn"
                                        title="Modificar">✏️</a>
                                    <a href="/admin/movies/delete/<%= peli.id_pelicula %>" class="peli-btn"
                                        title="Eliminar">🗑️</a>
                                </div>
                    </div>
                    <h2 class="peli-titulo">
                        <%= peli.tit_pelicula %>
                    </h2>
                    <div class="detalle-card flexColumn">
                        <p class="detalle-descripcion"><span class="negrita">Director:</span>
                            <%= peli.director %>
                        </p>
                        <p class="detalle-descripcion"><span class=" negrita">Año:</span>
                            <%= peli.ano_pelicula %>
                        </p>
                        <p class="detalle-descripcion"><span class="negrita">Género:</span>
                            <%= peli.genero %>
                        </p>
                        <p class="detalle-descripcion"><span class="negrita">Duración:</span>
                            <%= peli.duracion %>
                        </p>
                    </div>
                </div>
                <% }); %>
        </div>

    </main>

    <%- include("../../templates/footer") %>