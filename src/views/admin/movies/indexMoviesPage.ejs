<%- include("../../templates/header") %>

    <main class="container">
        <h1>Películas</h1>
        <a href="./create"><button>Añadir película</button></a>
        <table>
            <thead>
                <tr>
                    <!-- <th>ID</th> -->
                    <th>Título</th>
                    <th>Director</th>
                    <th>Año</th>
                    <th>Género</th>
                    <th>Duración</th>
                    <th>Imagen</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% peliculas.forEach((peli) => { %>
                    <tr>
                        <!-- <td><%= peli.id %></td> -->
                        <td><%= peli.titulo %></td>
                        <td><%= peli.director %></td>
                        <td><%= peli.ano %></td>
                        <td><%= peli.genero %></td>
                        <td><%= peli.duracion %></td>
                        <td><img src="<%= peli.imagen %>" alt="Imagen de <%= peli.titulo %>"></td>
                        <td>
                            <form action="http://localhost:4001/api/v1/admin/peliculas/<%= peli.id %>" method="delete">
                                <button type="submit">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>

    </main>
    <%- include("../../templates/footer") %>