<%- include("../../templates/header") %>

    <main class="container">
        <h1>Editar una película</h1>

        <form action="<%= urlEdit %><%= pelicula.id %>" method="PUT"
            enctype="multipart/form-data" class="flexColumn">
            <input type="number" id="id_pelicula" name="id_pelicula" value="<%= pelicula.id %>" hidden novalidate>
            <div class="flexColumn">
                <label for="tit_pelicula">Título</label>
                <input type="text" id="tit_pelicula" name="tit_pelicula" value="<%= pelicula.titulo %>" novalidate>
            </div>
            <div class="flexColumn">
                <label for="director">Director</label>
                <input type="text" id="director" name="director" value="<%= pelicula.director %>" novalidate>
            </div>
            <div class="flexColumn">
                <label for="ano_pelicula">Año</label>
                <input type="number" id="ano_pelicula" name="ano_pelicula" value="<%= pelicula.ano %>" novalidate>
            </div>
            <div class="flexColumn">
                <label for="genero">Genero</label>
                <input type="text" id="genero" name="genero" value="<%= pelicula.genero %>" novalidate>
            </div>
            <div class="flexColumn">
                <label for="duracion">Duración</label>
                <input type="text" id="duracion" name="duracion" value="<%= pelicula.duracion %>" novalidate>
            </div>
            <div class="flexColumn">
                <label for="img_pelicula">Imagen</label>
                <input type="file" id="img_pelicula" name="img_pelicula" value="<%= pelicula.imagen %>" novalidate>
            </div>

            <input type="submit">
        </form>
    </main>
    <%- include("../../templates/footer") %>