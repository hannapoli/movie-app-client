<%- include("../../templates/header") %>
<%- include("../template/navAdmin") %>

    <main class="container">
        <h1>Modificar la película</h1>

        <form action="/admin/movies/edit/<%= pelicula.id_pelicula %>" method="POST" enctype="multipart/form-data"
            class="flexColumn auth-form">
            <input type="number" id="id_pelicula" name="id_pelicula" value="<%= pelicula.id_pelicula %>" hidden
                novalidate>
            <div class="flexColumn">
                <label for="tit_pelicula">Título</label>
                <input type="text" id="tit_pelicula" name="tit_pelicula" value="<%= pelicula.tit_pelicula %>"
                    novalidate>
            </div>
            <div class="flexColumn">
                <label for="director">Director</label>
                <input type="text" id="director" name="director" value="<%= pelicula.director %>" novalidate>
            </div>
            <div class="flexColumn">
                <label for="ano_pelicula">Año</label>
                <input type="number" id="ano_pelicula" name="ano_pelicula" value="<%= pelicula.ano_pelicula %>"
                    novalidate>
            </div>
            <div class="flexColumn">
                <label for="genero">Genero</label>
                <input type="text" id="genero" name="genero" value="<%= pelicula.genero %>" novalidate>
            </div>
            <div class="flexColumn">
                <label for="duracion">Duración</label>
                <input type="text" id="duracion" name="duracion" value="<%= pelicula.duracion %>" novalidate>
            </div>
            <div class="flexColumn">
                <label for="imagen">Portada</label>
                <input type="file" id="imagen" name="imagen" novalidate>
                <% if (pelicula.filename) { %>
                    <p class="info">Actual: <%= pelicula.filename %>
                    </p>
                    <% } %>
            </div>
            <div class="flexColumn container-btn">
                <button type="submit" class="btn-primary">Modificar</button>
            </div>
        </form>
    </main>
    <%- include("../../templates/footer") %>